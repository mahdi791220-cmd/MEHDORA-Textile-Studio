--- /dev/null
+++ b/plugins/python/mehdora_textile/mehdora_textile/__init__.py
@@ -0,0 +1 @@
+from .mehdora_textile import *
diff --git a/plugins/python/mehdora_textile/mehdora_textile/mehdora_textile.py b/plugins/python/mehdora_textile/mehdora_textile/mehdora_textile.py
new file mode 100644
index 0000000..9634b07
--- /dev/null
+++ b/plugins/python/mehdora_textile/mehdora_textile/mehdora_textile.py
@@ -0,0 +1,189 @@
+from krita import Krita, DockWidget, DockWidgetFactory, DockWidgetFactoryBase
+try:
+    from PyQt6.QtCore import Qt
+    from PyQt6.QtWidgets import (
+        QWidget, QVBoxLayout, QHBoxLayout, QLabel, QPushButton, QGroupBox,
+        QTreeWidget, QTreeWidgetItem, QMessageBox, QSpinBox, QComboBox
+    )
+    ALIGN_CENTER = Qt.AlignmentFlag.AlignCenter
+    USER_ROLE = Qt.ItemDataRole.UserRole
+except ImportError:
+    from PyQt5.QtCore import Qt
+    from PyQt5.QtWidgets import (
+        QWidget, QVBoxLayout, QHBoxLayout, QLabel, QPushButton, QGroupBox,
+        QTreeWidget, QTreeWidgetItem, QMessageBox, QSpinBox, QComboBox
+    )
+    ALIGN_CENTER = Qt.AlignCenter
+    USER_ROLE = Qt.UserRole
+
+
+class MehdoraTextileDocker(DockWidget):
+    """Built-in textile workflow panel shipped with MEHDORA."""
+
+    def __init__(self):
+        super().__init__()
+        self.setWindowTitle("MEHDORA — پارچه")
+        root = QWidget(self)
+        layout = QVBoxLayout(root)
+
+        title = QLabel("MEHDORA\nTEXTILE STUDIO")
+        title.setAlignment(ALIGN_CENTER)
+        title.setStyleSheet(
+            "font-size:18px;font-weight:700;color:#d7aa52;"
+            "padding:12px;background:#173943;border-radius:6px;"
+        )
+        layout.addWidget(title)
+
+        self.document_info = QLabel("یک فایل TIFF، PSD یا تصویر باز کن")
+        self.document_info.setWordWrap(True)
+        self.document_info.setStyleSheet(
+            "padding:8px;background:#252525;border-radius:4px;"
+        )
+        layout.addWidget(self.document_info)
+
+        repeat_box = QGroupBox("تکرار و Seamless")
+        repeat_layout = QVBoxLayout(repeat_box)
+        self.wrap_button = QPushButton("روشن/خاموش کردن تکرار زنده")
+        self.wrap_button.clicked.connect(self.toggle_wrap)
+        repeat_layout.addWidget(self.wrap_button)
+        repeat_row = QHBoxLayout()
+        repeat_row.addWidget(QLabel("عرض تکرار (cm)"))
+        self.repeat_width = QSpinBox()
+        self.repeat_width.setRange(1, 500)
+        self.repeat_width.setValue(36)
+        repeat_row.addWidget(self.repeat_width)
+        repeat_layout.addLayout(repeat_row)
+        layout.addWidget(repeat_box)
+
+        colorway_box = QGroupBox("رنگ‌بندی و لایه‌ها")
+        colorway_layout = QVBoxLayout(colorway_box)
+        self.colorway_count = QComboBox()
+        self.colorway_count.addItems(
+            ["5 رنگ‌بندی", "10 رنگ‌بندی", "15 رنگ‌بندی", "20 رنگ‌بندی"]
+        )
+        colorway_layout.addWidget(self.colorway_count)
+        create_group = QPushButton("ساخت گروه رنگ‌بندی از لایه فعال")
+        create_group.clicked.connect(self.create_colorway_group)
+        colorway_layout.addWidget(create_group)
+        overlay = QPushButton("Overlay با شفافیت 100٪")
+        overlay.clicked.connect(self.apply_overlay)
+        colorway_layout.addWidget(overlay)
+        duplicate = QPushButton("کپی رنگ‌بندی انتخابی")
+        duplicate.clicked.connect(self.duplicate_colorway)
+        colorway_layout.addWidget(duplicate)
+        layout.addWidget(colorway_box)
+
+        layers_box = QGroupBox("ساختار کامل لایه‌های سند")
+        layers_layout = QVBoxLayout(layers_box)
+        self.layers = QTreeWidget()
+        self.layers.setHeaderLabels(["نام لایه", "نوع"])
+        self.layers.itemDoubleClicked.connect(self.select_layer)
+        layers_layout.addWidget(self.layers)
+        refresh = QPushButton("بروزرسانی فهرست لایه‌ها")
+        refresh.clicked.connect(self.refresh)
+        layers_layout.addWidget(refresh)
+        layout.addWidget(layers_box, 1)
+
+        note = QLabel(
+            "TIFF لایه‌دار فتوشاپ، PSD، مدیریت رنگ و فایل‌های سنگین "
+            "با موتور داخلی برنامه پردازش می‌شوند."
+        )
+        note.setWordWrap(True)
+        note.setStyleSheet("color:#aaa;font-size:10px;padding:6px;")
+        layout.addWidget(note)
+        self.setWidget(root)
+
+    def canvasChanged(self, canvas):
+        self.refresh()
+
+    @staticmethod
+    def document():
+        return Krita.instance().activeDocument()
+
+    def add_node(self, node, parent=None):
+        item = QTreeWidgetItem([node.name(), node.type()])
+        item.setData(0, USER_ROLE, node.uniqueId().toString())
+        if parent is None:
+            self.layers.addTopLevelItem(item)
+        else:
+            parent.addChild(item)
+        for child in node.childNodes():
+            self.add_node(child, item)
+
+    def refresh(self):
+        doc = self.document()
+        self.layers.clear()
+        if not doc:
+            self.document_info.setText("یک فایل TIFF، PSD یا تصویر باز کن")
+            return
+        self.document_info.setText(
+            f"{doc.name()}\n{doc.width()} × {doc.height()} px · "
+            f"{doc.resolution()} PPI · {len(doc.topLevelNodes())} لایه اصلی"
+        )
+        for node in reversed(doc.topLevelNodes()):
+            self.add_node(node)
+        self.layers.expandAll()
+
+    def toggle_wrap(self):
+        action = Krita.instance().action("wrap_around_mode")
+        if action:
+            action.trigger()
+        else:
+            QMessageBox.information(
+                self, "MEHDORA", "حالت تکرار زنده در این ساخت پیدا نشد."
+            )
+
+    def create_colorway_group(self):
+        doc = self.document()
+        if not doc or not doc.activeNode():
+            QMessageBox.warning(
+                self, "MEHDORA", "ابتدا یک سند و لایه را انتخاب کن."
+            )
+            return
+        source = doc.activeNode()
+        group = doc.createGroupLayer("MEHDORA Colorway 01")
+        copy = source.duplicate()
+        copy.setName(source.name() + " — Colorway")
+        doc.rootNode().addChildNode(group, None)
+        group.addChildNode(copy, None)
+        doc.setActiveNode(copy)
+        doc.refreshProjection()
+        self.refresh()
+
+    def apply_overlay(self):
+        doc = self.document()
+        if not doc or not doc.activeNode():
+            return
+        node = doc.activeNode()
+        node.setBlendingMode("overlay")
+        node.setOpacity(255)
+        doc.refreshProjection()
+        self.refresh()
+
+    def duplicate_colorway(self):
+        doc = self.document()
+        if not doc or not doc.activeNode():
+            return
+        source = doc.activeNode()
+        copy = source.duplicate()
+        copy.setName(source.name() + " Copy")
+        source.parentNode().addChildNode(copy, source)
+        doc.setActiveNode(copy)
+        doc.refreshProjection()
+        self.refresh()
+
+    def select_layer(self, item):
+        doc = self.document()
+        if not doc:
+            return
+        matches = doc.rootNode().findChildNodes(item.text(0))
+        if matches:
+            doc.setActiveNode(matches[0])
+
+
+factory = DockWidgetFactory(
+    "mehdora_textile_docker",
+    DockWidgetFactoryBase.DockRight,
+    MehdoraTextileDocker,
+)
+Krita.instance().addDockWidgetFactory(factory)
