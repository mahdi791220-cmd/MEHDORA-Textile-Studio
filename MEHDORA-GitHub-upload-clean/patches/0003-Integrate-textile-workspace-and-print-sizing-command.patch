+class MehdoraTextileExtension(Extension):
+    """MEHDORA commands exposed in the application's Scripts menu."""
+
+    def setup(self):
+        pass
+
+    def createActions(self, window):
+        wrap = window.createAction(
+            "mehdora_wrap_preview",
+            "MEHDORA — پیش‌نمایش تکرار زنده"
+        )
+        wrap.triggered.connect(self.toggle_wrap)
+
+        overlay = window.createAction(
+            "mehdora_overlay_100",
+            "MEHDORA — Overlay با شفافیت 100٪"
+        )
+        overlay.triggered.connect(self.overlay_100)
+
+        colorway = window.createAction(
+            "mehdora_duplicate_colorway",
+            "MEHDORA — کپی رنگ‌بندی"
+        )
+        colorway.triggered.connect(self.duplicate_colorway)
+
+    @staticmethod
+    def toggle_wrap():
+        action = Krita.instance().action("wrap_around_mode")
+        if action:
+            action.trigger()
+
+    @staticmethod
+    def overlay_100():
+        doc = Krita.instance().activeDocument()
+        if doc and doc.activeNode():
+            doc.activeNode().setBlendingMode("overlay")
+            doc.activeNode().setOpacity(255)
+            doc.refreshProjection()
+
+    @staticmethod
+    def duplicate_colorway():
+        doc = Krita.instance().activeDocument()
+        if not doc or not doc.activeNode():
+            return
+        source = doc.activeNode()
+        copy = source.duplicate()
+        copy.setName(source.name() + " — Colorway Copy")
+        source.parentNode().addChildNode(copy, source)
+        doc.setActiveNode(copy)
+        doc.refreshProjection()
+
+
 factory = DockWidgetFactory(
     "mehdora_textile_docker",
     DockWidgetFactoryBase.DockRight,
     MehdoraTextileDocker,
 )
 Krita.instance().addDockWidgetFactory(factory)
+Krita.instance().addExtension(MehdoraTextileExtension(Krita.instance()))
