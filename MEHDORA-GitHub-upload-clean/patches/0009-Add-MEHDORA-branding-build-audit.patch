--- /dev/null
+++ b/tools/verify_mehdora_branding.py
@@ -0,0 +1,94 @@
+#!/usr/bin/env python3
+"""Fail the build when the Windows MEHDORA identity is incomplete."""
+
+from __future__ import annotations
+
+import struct
+import sys
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def require_text(path: str, *needles: str) -> None:
+    content = (ROOT / path).read_text(encoding="utf-8")
+    for needle in needles:
+        if needle not in content:
+            raise AssertionError(f"{path}: missing {needle!r}")
+
+
+def forbid_text(path: str, *needles: str) -> None:
+    content = (ROOT / path).read_text(encoding="utf-8")
+    for needle in needles:
+        if needle in content:
+            raise AssertionError(f"{path}: visible legacy branding {needle!r}")
+
+
+def png_size(path: Path) -> tuple[int, int]:
+    data = path.read_bytes()[:24]
+    if data[:8] != b"\x89PNG\r\n\x1a\n":
+        raise AssertionError(f"{path}: not a PNG file")
+    return struct.unpack(">II", data[16:24])
+
+
+def verify_icons() -> None:
+    icon_dir = ROOT / "krita/pics/branding/default"
+    for size in (16, 22, 24, 32, 48, 64, 128, 256, 512, 1024):
+        path = icon_dir / f"{size}-apps-krita.png"
+        if png_size(path) != (size, size):
+            raise AssertionError(f"{path}: incorrect dimensions")
+
+    ico = (icon_dir / "krita.ico").read_bytes()
+    reserved, image_type, count = struct.unpack("<HHH", ico[:6])
+    if reserved != 0 or image_type != 1 or count < 6:
+        raise AssertionError("Windows application icon is invalid")
+
+
+def main() -> int:
+    require_text(
+        "krita/CMakeLists.txt",
+        'OUTPUT_NAME "MEHDORA-Textile-Studio"',
+    )
+    require_text(
+        "krita/main.cc",
+        '"MEHDORA Textile Studio"',
+        '"mehdora-textile-studio"',
+        '"app.mehdora.textilestudio"',
+        "MehdoraBrandingFilter",
+    )
+    require_text(
+        "krita/versioninfo.rc.in",
+        '#define KRITA_FOUNDATION_STR "MEHDORA"',
+        'VALUE "ProductName", "MEHDORA Textile Studio"',
+        'VALUE "OriginalFilename", "MEHDORA-Textile-Studio.exe"',
+    )
+    require_text(
+        "packaging/windows/installer/installer_krita.nsi",
+        '!define MUI_STARTMENUPAGE_DEFAULTFOLDER "MEHDORA Textile Studio"',
+        '!define KRTIA_PUBLISHER "MEHDORA"',
+    )
+
+    forbid_text(
+        "krita/kritamenu.action",
+        "About Krita",
+        "Configure Krita",
+        "Krita Handbook",
+    )
+    forbid_text(
+        "krita/versioninfo.rc.in",
+        '"Krita Foundation"',
+        '"Krita"',
+    )
+
+    verify_icons()
+    print("MEHDORA branding audit passed")
+    return 0
+
+
+if __name__ == "__main__":
+    try:
+        raise SystemExit(main())
+    except (AssertionError, OSError, UnicodeError) as error:
+        print(f"MEHDORA branding audit failed: {error}", file=sys.stderr)
+        raise SystemExit(1)
