+class MehdoraBrand:
+    """Keep the visible application shell branded as MEHDORA."""
+
+    PRODUCT_NAME = "MEHDORA Textile Studio"
+
+    def __init__(self):
+        self.icon = QIcon(os.path.join(os.path.dirname(__file__), "mehdora.ico"))
+        app = QApplication.instance()
+        if app:
+            app.setApplicationName(self.PRODUCT_NAME)
+            app.setApplicationDisplayName(self.PRODUCT_NAME)
+            if not self.icon.isNull():
+                app.setWindowIcon(self.icon)
+
+        self.timer = QTimer()
+        self.timer.setInterval(750)
+        self.timer.timeout.connect(self.refresh_windows)
+        self.timer.start()
+        self.refresh_windows()
+
+    def refresh_windows(self):
+        app = QApplication.instance()
+        if not app:
+            return
+        for widget in app.topLevelWidgets():
+            title = widget.windowTitle()
+            if "Krita" in title:
+                widget.setWindowTitle(title.replace("Krita", self.PRODUCT_NAME))
+            elif not title and widget.isWindow():
+                widget.setWindowTitle(self.PRODUCT_NAME)
+            if not self.icon.isNull():
+                widget.setWindowIcon(self.icon)
+
