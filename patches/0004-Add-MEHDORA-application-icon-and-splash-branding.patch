diff --git a/tools/render_mehdora_branding.py b/tools/render_mehdora_branding.py
new file mode 100644
index 0000000..d0a1c16
--- /dev/null
+++ b/tools/render_mehdora_branding.py
@@ -0,0 +1,105 @@
+#!/usr/bin/env python3
+"""Render deterministic MEHDORA raster branding assets."""
+
+from pathlib import Path
+from PIL import Image, ImageDraw, ImageFont
+
+
+ROOT = Path(__file__).resolve().parents[1]
+BRANDING = ROOT / "krita" / "pics" / "branding" / "default"
+SPLASH = ROOT / "krita" / "data" / "splash"
+
+
+def font(size, bold=False):
+    candidates = [
+        "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf"
+        if bold else
+        "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
+        "/usr/share/fonts/truetype/liberation2/LiberationSans-Bold.ttf"
+        if bold else
+        "/usr/share/fonts/truetype/liberation2/LiberationSans-Regular.ttf",
+    ]
+    for candidate in candidates:
+        if Path(candidate).exists():
+            return ImageFont.truetype(candidate, size)
+    return ImageFont.load_default()
+
+
+def logo(size):
+    scale = size / 1024
+    image = Image.new("RGBA", (size, size), (0, 0, 0, 0))
+    draw = ImageDraw.Draw(image)
+    radius = round(220 * scale)
+    draw.rounded_rectangle(
+        (round(32 * scale),) * 2 + (round(992 * scale),) * 2,
+        radius=radius,
+        fill=(10, 55, 65, 255),
+    )
+    points = [
+        (195, 735), (195, 294), (245, 262), (512, 515),
+        (779, 262), (829, 294), (829, 735), (699, 735),
+        (699, 447), (557, 584), (467, 584), (325, 447),
+        (325, 735),
+    ]
+    points = [(round(x * scale), round(y * scale)) for x, y in points]
+    draw.polygon(points, fill=(215, 170, 82, 255))
+    for y, margin in ((782, 150), (832, 190)):
+        draw.line(
+            (round(margin * scale), round(y * scale),
+             round((1024 - margin) * scale), round(y * scale)),
+            fill=(246, 234, 208, 255),
+            width=max(1, round(28 * scale)),
+        )
+    return image
+
+
+def render_icons():
+    sizes = [16, 22, 24, 32, 48, 64, 128, 256, 512, 1024]
+    rendered = {}
+    for size in sizes:
+        rendered[size] = logo(size)
+        rendered[size].save(BRANDING / f"{size}-apps-krita.png")
+    rendered[256].save(
+        BRANDING / "krita.ico",
+        format="ICO",
+        sizes=[(16, 16), (32, 32), (48, 48), (64, 64),
+               (128, 128), (256, 256)],
+    )
+
+
+def render_splash():
+    width, height = 1600, 900
+    image = Image.new("RGB", (width, height), (7, 31, 39))
+    draw = ImageDraw.Draw(image)
+    for y in range(height):
+        t = y / (height - 1)
+        draw.line((0, y, width, y), fill=(
+            round(7 + 5 * (1 - abs(t - .5) * 2)),
+            round(31 + 38 * (1 - abs(t - .5) * 2)),
+            round(39 + 42 * (1 - abs(t - .5) * 2)),
+        ))
+    for x in range(-height, width, 110):
+        draw.line((x, 0, x + height, height), fill=(35, 92, 96), width=2)
+    mark = logo(430)
+    image.paste(mark, ((width - 430) // 2, 105), mark)
+
+    title_font = font(104, True)
+    sub_font = font(36, True)
+    small_font = font(24)
+    draw.text((width // 2, 625), "MEHDORA", anchor="mm",
+              font=title_font, fill=(247, 236, 212))
+    draw.text((width // 2, 715), "TEXTILE STUDIO", anchor="mm",
+              font=sub_font, fill=(215, 170, 82))
+    draw.text(
+        (width // 2, 800),
+        "Professional textile design  •  colorway  •  seamless repeat",
+        anchor="mm",
+        font=small_font,
+        fill=(220, 232, 231),
+    )
+    image.save(SPLASH / "mehdora-splash.png", optimize=True)
+
+
+if __name__ == "__main__":
+    render_icons()
+    render_splash()
