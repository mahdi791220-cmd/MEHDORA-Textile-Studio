diff --git a/tools/render_mehdora_branding.py b/tools/render_mehdora_branding.py
index 646c36d..20af42a 100644
--- a/tools/render_mehdora_branding.py
+++ b/tools/render_mehdora_branding.py
@@ -2,7 +2,7 @@
 """Render deterministic MEHDORA raster branding assets."""
 
 from pathlib import Path
-from PIL import Image, ImageDraw, ImageFont
+from PIL import Image, ImageDraw, ImageFont, ImageOps
 
 
 ROOT = Path(__file__).resolve().parents[1]
@@ -78,29 +78,35 @@ def render_icons():
 
 def render_splash():
     width, height = 1600, 900
-    image = Image.new("RGB", (width, height), (7, 31, 39))
+    heritage_path = SPLASH / "mehdora-heritage-background.png"
+    if heritage_path.exists():
+        image = ImageOps.fit(
+            Image.open(heritage_path).convert("RGB"),
+            (width, height),
+            method=Image.Resampling.LANCZOS,
+        )
+    else:
+        image = Image.new("RGB", (width, height), (7, 31, 39))
+
+    overlay = Image.new("RGBA", (width, height), (0, 0, 0, 0))
+    overlay_draw = ImageDraw.Draw(overlay)
+    for y in range(520):
+        alpha = round(155 * (1 - y / 520))
+        overlay_draw.line((0, y, width, y), fill=(5, 31, 38, alpha))
+    image = Image.alpha_composite(image.convert("RGBA"), overlay).convert("RGB")
     draw = ImageDraw.Draw(image)
-    for y in range(height):
-        t = y / (height - 1)
-        draw.line((0, y, width, y), fill=(
-            round(7 + 5 * (1 - abs(t - .5) * 2)),
-            round(31 + 38 * (1 - abs(t - .5) * 2)),
-            round(39 + 42 * (1 - abs(t - .5) * 2)),
-        ))
-    for x in range(-height, width, 110):
-        draw.line((x, 0, x + height, height), fill=(35, 92, 96), width=2)
-    mark = logo(430)
-    image.paste(mark, ((width - 430) // 2, 105), mark)
+    mark = logo(190)
+    image.paste(mark, ((width - 190) // 2, 38), mark)
 
-    title_font = font(104, True)
-    sub_font = font(36, True)
-    small_font = font(24)
-    draw.text((width // 2, 625), "MEHDORA", anchor="mm",
+    title_font = font(72, True)
+    sub_font = font(27, True)
+    small_font = font(18)
+    draw.text((width // 2, 275), "MEHDORA", anchor="mm",
               font=title_font, fill=(247, 236, 212))
-    draw.text((width // 2, 715), "TEXTILE STUDIO", anchor="mm",
+    draw.text((width // 2, 335), "TEXTILE STUDIO", anchor="mm",
               font=sub_font, fill=(215, 170, 82))
     draw.text(
-        (width // 2, 800),
+        (width // 2, 382),
         "Professional textile design  •  colorway  •  seamless repeat",
         anchor="mm",
         font=small_font,
-- 
2.51.1

