+class MehdoraBrandingFilter final : public QObject
+{
+public:
+    explicit MehdoraBrandingFilter(QObject *parent = nullptr)
+        : QObject(parent)
+    {
+    }
+
+protected:
+    bool eventFilter(QObject *watched, QEvent *event) override
+    {
+        switch (event->type()) {
+        case QEvent::Show:
+        case QEvent::Polish:
+        case QEvent::ActionAdded:
+        case QEvent::ChildAdded:
+        case QEvent::LanguageChange:
+            sanitizeTree(watched);
+            break;
+        default:
+            break;
+        }
+        return QObject::eventFilter(watched, event);
+    }
+
+private:
+    static QString branded(QString text)
+    {
+        text.replace(QStringLiteral("Krita"), QStringLiteral("MEHDORA"));
+        text.replace(QStringLiteral("krita"), QStringLiteral("MEHDORA"));
+        return text;
+    }
+
+    static void sanitizeProperty(QObject *object, const char *propertyName)
+    {
+        const int propertyIndex = object->metaObject()->indexOfProperty(propertyName);
+        if (propertyIndex < 0) {
+            return;
+        }
+
+        const QMetaProperty property = object->metaObject()->property(propertyIndex);
+        if (!property.isReadable() || !property.isWritable() ||
+            property.userType() != QMetaType::QString) {
+            return;
+        }
+
+        const QString current = property.read(object).toString();
+        const QString replacement = branded(current);
+        if (replacement != current) {
+            property.write(object, replacement);
+        }
+    }
+
+    static void sanitizeTree(QObject *object)
+    {
+        if (!object) {
+            return;
+        }
+
+        static const char *properties[] = {
+            "windowTitle",
+            "text",
+            "title",
+            "toolTip",
+            "statusTip",
+            "whatsThis",
+            "placeholderText",
+            "accessibleName",
+            "accessibleDescription"
+        };
+
+        for (const char *propertyName : properties) {
+            sanitizeProperty(object, propertyName);
+        }
+
+        const QObjectList children = object->children();
+        for (QObject *child : children) {
+            sanitizeTree(child);
+        }
+    }
+};
+}
